{
  "name": "solara",
  "private": true,
  "version": "0.1.0",
  "description": "An open-world driving and exploration prototype, generated entirely at runtime from code — no model, texture or audio files.",
  "license": "MIT",
  "author": "Johan Svartdal",
  "type": "module",
  "keywords": [
    "threejs",
    "webgl",
    "procedural-generation",
    "game",
    "open-world",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
